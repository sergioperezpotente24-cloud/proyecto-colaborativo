<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galería de música</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Menú de navegación -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <!-- Logo o nombre -->
            <a class="navbar-brand" href="#">Mi Web</a>

            <!-- Botón hamburguesa -->
            <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menuPrincipal"
                aria-controls="menuPrincipal"
                aria-expanded="false"
                aria-label="Abrir menú">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Opciones del menú -->
            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="menu.html">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Servicios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Nosotros</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Contacto</a>
                    </li>
                </ul>
            </div>

        </div>
    </nav>
    <div class="container mt-4 mb-4">
        <h1 class="text-center">Galería de música</h1>
        <p class="text-center">Descubre algunos géneros musicales y sus características.</p>

        <div class="row">
            <div class="col-12 col-lg-12 border border-dark p-2">
                <h3>Géneros</h3>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-lg-3 border border-dark p-2">
                <div class="card h-100 shadow-sm" style="max-width:22rem;">
                    <img src="img/metal.jpg" class="card-img-top" alt="Imagen representativa de Metal">
                    <div class="card-body">
                        <h5 class="card-title">Metal</h5>
                        <p class="card-text">Guitarras distorsionadas, ritmos intensos y mucha potencia.</p>
                        <a href="https://es.wikipedia.org/wiki/Heavy_metal" class="btn btn-success" target="_blank" rel="noopener noreferrer">Más sobre este género</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-3 border border-dark p-2">
                <div class="card h-100 shadow-sm" style="max-width:22rem;">
                    <img src="img/rock.jpg" class="card-img-top" alt="Imagen representativa de Rock">
                    <div class="card-body">
                        <h5 class="card-title">Rock</h5>
                        <p class="card-text">Guitarras eléctricas, energía y grandes bandas.</p>
                        <a href="https://es.wikipedia.org/wiki/Rock" class="btn btn-success" target="_blank" rel="noopener noreferrer">Más sobre este género</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-3 border border-dark p-2">
                <div class="card h-100 shadow-sm" style="max-width:22rem;">
                    <img src="img/punk.jpg" class="card-img-top" alt="Imagen representativa de Punk">
                    <div class="card-body">
                        <h5 class="card-title">Punk</h5>
                        <p class="card-text">Canciones directas, ritmos rápidos y actitud rebelde.</p>
                        <a href="https://es.wikipedia.org/wiki/Punk_rock" class="btn btn-success" target="_blank" rel="noopener noreferrer">Más sobre este género</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-3 border border-dark p-2">
                <div class="card h-100 shadow-sm" style="max-width:22rem;">
                    <img src="img/reggae.jpg" class="card-img-top" alt="Imagen representativa de Reggae">
                    <div class="card-body">
                        <h5 class="card-title">Reggae</h5>
                        <p class="card-text">Ritmos tranquilos, bajos marcados y raíces jamaicanas.</p>
                        <a href="https://es.wikipedia.org/wiki/Reggae" class="btn btn-success" target="_blank" rel="noopener noreferrer">Más sobre este género</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-3 border border-dark p-2">
                <div class="card h-100 shadow-sm" style="max-width:22rem;">
                    <img src="img/pop.jpg" class="card-img-top" alt="Imagen representativa de Pop">
                    <div class="card-body">
                        <h5 class="card-title">Pop</h5>
                        <p class="card-text">Melodías pegadizas y canciones muy populares.</p>
                        <a href="https://es.wikipedia.org/wiki/M%C3%BAsica_pop" class="btn btn-success" target="_blank" rel="noopener noreferrer">Más sobre este género</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-3 border border-dark p-2">
                <div class="card h-100 shadow-sm" style="max-width:22rem;">
                    <img src="img/jazz.jpg" class="card-img-top" alt="Imagen representativa de Jazz">
                    <div class="card-body">
                        <h5 class="card-title">Jazz</h5>
                        <p class="card-text">Improvisación, instrumentos acústicos y creatividad.</p>
                        <a href="https://es.wikipedia.org/wiki/Jazz" class="btn btn-success" target="_blank" rel="noopener noreferrer">Más sobre este género</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-3 border border-dark p-2">
                <div class="card h-100 shadow-sm" style="max-width:22rem;">
                    <img src="img/electronica.jpg" class="card-img-top" alt="Imagen representativa de Electrónica">
                    <div class="card-body">
                        <h5 class="card-title">Electrónica</h5>
                        <p class="card-text">Sonidos digitales, sintetizadores y ritmos de baile.</p>
                        <a href="https://es.wikipedia.org/wiki/M%C3%BAsica_electr%C3%B3nica" class="btn btn-success" target="_blank" rel="noopener noreferrer">Más sobre este género</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-3 border border-dark p-2">
                <div class="card h-100 shadow-sm" style="max-width:22rem;">
                    <img src="img/clasica.jpg" class="card-img-top" alt="Imagen representativa de Clásica">
                    <div class="card-body">
                        <h5 class="card-title">Clásica</h5>
                        <p class="card-text">Orquestas, composiciones y siglos de historia musical.</p>
                        <a href="https://es.wikipedia.org/wiki/M%C3%BAsica_cl%C3%A1sica" class="btn btn-success" target="_blank" rel="noopener noreferrer">Más sobre este género</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-dark text-white text-center p-3 mt-auto">
        <p class="mb-0">Galería musical - Proyecto de clase</p>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
