
/* ESTILO GENERAL */
body {
    background: linear-gradient(135deg, #141e46, #37215f, #633b8f);
    font-family: 'Segoe UI', Arial, sans-serif;
    min-height: 100vh;
    margin: 0;
}

/* MENÚ DE NAVEGACIÓN */
.navbar {
    background: #17152e !important;
    padding: 18px 0;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
}

.navbar-brand {
    font-size: 25px;
    font-weight: bold;
    color: #c9a7ff !important;
    letter-spacing: 1px;
}

.nav-link {
    color: white !important;
    margin-left: 15px;
    transition: 0.3s;
}

.nav-link:hover,
.nav-link.active {
    color: #c9a7ff !important;
}

/* TARJETA DEL FORMULARIO */
.card {
    background: #ffffff;
    border-radius: 25px !important;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3) !important;
    transition: transform 0.3s;
}

.card:hover {
    transform: translateY(-5px);
}

.card-body {
    padding: 40px !important;
}

/* TÍTULOS */
h1 {
    color: #39205e;
    font-weight: 800;
    font-size: 32px;
}

.card p {
    color: #777 !important;
    font-size: 16px;
}

/* ETIQUETAS */
.form-label {
    color: #39205e;
    font-weight: 600;
    margin-bottom: 8px;
}

/* CAMPOS DE TEXTO */
.form-control,
.form-select {
    border: 2px solid #e3d9f2;
    border-radius: 12px;
    padding: 12px 15px;
    transition: 0.3s;
}

.form-control:focus,
.form-select:focus {
    border-color: #8954c7;
    box-shadow: 0 0 0 4px rgba(137, 84, 199, 0.15);
}

/* BOTÓN */
.btn-success {
    background: linear-gradient(135deg, #7b3fc2, #51258c);
    border: none;
    border-radius: 12px;
    padding: 13px;
    font-weight: bold;
    transition: 0.3s;
}

.btn-success:hover {
    background: linear-gradient(135deg, #51258c, #35145f);
    transform: scale(1.03);
    box-shadow: 0 6px 15px rgba(81, 37, 140, 0.3);
}

/* IMAGEN */
img {
    border: 4px solid white;
    transition: 0.3s;
}

img:hover {
    transform: scale(1.04);
}

/* PIE DE PÁGINA */
footer {
    background: #17152e !important;
    color: #d8c3f5 !important;
    padding: 20px !important;
    margin-top: 30px;
    font-size: 15px;
}

/* DISEÑO PARA MÓVILES */
@media (max-width: 576px) {
    .card-body {
        padding: 25px !important;
    }

    h1 {
        font-size: 26px;
    }

    .navbar-brand {
        font-size: 21px;
    }
}



